# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Prof. Mohammed Dauda Portfolio
#
# Copy this file to .env.local and fill in the real values.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Firebase Web SDK (public — safe to expose in browser bundles) ─────────────
# All values are found in Firebase Console → Project Settings → General → Your apps
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key-here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:abcdef1234567890
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Admin bootstrap email ─────────────────────────────────────────────────────
# The Firebase Auth email of the FIRST superadmin.
# Used as a fallback before the first adminUsers document is created via
# the provisioning script (see README → Initial Admin Setup).
# Once you have added yourself via the Users page, you can leave this blank.
NEXT_PUBLIC_ADMIN_EMAIL=admin@example.com

# ── Public site URL ───────────────────────────────────────────────────────────
# Used for canonical URLs, sitemap.xml, Open Graph metadata, and robots.txt.
# Include the protocol, no trailing slash.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
